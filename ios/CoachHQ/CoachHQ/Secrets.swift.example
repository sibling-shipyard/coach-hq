import Foundation

/// Copy this file to `Secrets.swift` (gitignored). Sign-in goes through the shared
/// coach-phelps-hq GitHub App + PKCE flow entirely server-side (ui/api/auth/) - there's no
/// client secret to register or embed here anymore.
///
/// `dashboardBaseURL` — hosted Coach HQ site that serves `/api/auth/*` and
/// `/api/widget-snapshots`. Defaults to production; override for local Vercel/Netlify dev if
/// needed.
enum Secrets {
    static let dashboardBaseURL = "https://coach-phelps-hq.vercel.app"
}
