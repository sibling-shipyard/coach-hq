import Foundation

/// Local GitHub OAuth App credentials — copy this file to `Secrets.swift` (gitignored) and
/// fill in your own values. Register a GitHub OAuth App at:
/// https://github.com/settings/developers
///
/// Authorization callback URL must be exactly: coachhq://callback
///
/// `dashboardBaseURL` — hosted Coach HQ site that serves `/api/widget-snapshots`.
/// Defaults to production; override for local Vercel/Netlify dev if needed.
enum Secrets {
    static let githubClientId = "YOUR_GITHUB_OAUTH_CLIENT_ID"
    static let githubClientSecret = "YOUR_GITHUB_OAUTH_CLIENT_SECRET"
    static let dashboardBaseURL = "https://coach-phelps-hq.vercel.app"
}
