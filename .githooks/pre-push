#!/usr/bin/env bash
#
# Repo-wide pre-push gate. check.sh configures this hook for the current clone.
# CI remains authoritative; this catches the same blocking failures before the round trip.
# --changed skips checks whose path globs miss this branch vs origin/main (ios-only
# must not wait on vitest). Run without --changed for the full gate.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 1

printf '\n[pre-push] Running the local gate for paths this branch changes...\n'
if ! bash "$ROOT/platform/scripts/check.sh" --quiet --changed; then
  printf '\n[pre-push] Push blocked. Fix the failed checks and try again.\n\n' >&2
  exit 1
fi

printf '\n[pre-push] Local gate passed.\n\n'
exit 0
