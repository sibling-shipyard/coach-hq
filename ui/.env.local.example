# Copy to ui/.env.local and fill in values for live local testing.
# Plain `npm run dev` ignores this file's auth override unless the var below is set.

# Opt into real GitHub OAuth + /api/repo-file (requires `vercel dev`, not Vite-only dev).
VITE_FORCE_HOSTED_AUTH=true

# Server-side secrets for vercel dev (vercel env pull also writes ui/.env.local):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# SESSION_SECRET=
# GEMINI_API_KEY=
