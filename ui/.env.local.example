# Copy to ui/.env.local for local testing against real GitHub login + Coach Chat.
# Never committed (.env.local is gitignored). Requires `npm run dev:api` running
# alongside `npm run dev` - see ui/scripts/local-api-server.mjs and #61/#63.

# Opt into real auth instead of the default local-dev bypass.
VITE_FORCE_HOSTED_AUTH=true

# Real secrets, read by ui/scripts/local-api-server.mjs (pull with `vercel env pull`
# or copy from the Vercel dashboard):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# SESSION_SECRET=
# GEMINI_API_KEY=
